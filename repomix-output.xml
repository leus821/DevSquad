<file path="src/features/apply-project/ui/ApplyButton.jsx">
'use client';
import { Button } from '@/shared/ui';
import { supabase } from '@/shared/lib/supabase';
import { useAuth } from '@/app/providers/AuthContext';
import { useState, useEffect } from 'react';

const ApplyButton = ({ vacancyId, projectId }) => {
	const { user } = useAuth();
	const [loading, setLoading] = useState(false);
	const [status, setStatus] = useState('idle'); // 'idle' | 'applied' | 'member'

	useEffect(() => {
		if (!user || !projectId || !vacancyId) return;

		const checkStatus = async () => {
			// 1. Проверяем, не является ли пользователь уже участником проекта
			const { data: project } = await supabase
				.from('projects')
				.select('members')
				.eq('id', projectId)
				.single();

			const isMember = project?.members?.some(m => m.user_id === user.id);
			if (isMember) {
				setStatus('member');
				return;
			}

			// 2. Проверяем, не подавался ли он уже конкретно на эту вакансию
			const { data: vac } = await supabase
				.from('vacancies')
				.select('applicants')
				.eq('id', vacancyId)
				.single();

			if (vac?.applicants?.includes(user.id)) {
				setStatus('applied');
			}
		};

		checkStatus();
	}, [user, projectId, vacancyId]);

	const handleApply = async (e) => {
		e.preventDefault();
		e.stopPropagation();

		if (!user) return alert('Войдите в аккаунт');
		if (status === 'member') return alert('Вы уже участвуете в этом проекте!');

		setLoading(true);

		try {
			const { data: vac } = await supabase
				.from('vacancies')
				.select('applicants, is_closed')
				.eq('id', vacancyId)
				.single();

			if (vac.is_closed) throw new Error("Вакансия закрыта");

			const { error } = await supabase
				.from('vacancies')
				.update({ 
					applicants: [...(vac.applicants || []), user.id] 
				})
				.eq('id', vacancyId);

			if (error) throw error;

			alert('Заявка отправлена!');
			setStatus('applied');
		} catch (err) {
			alert(err.message);
		} finally {
			setLoading(false);
		}
	};

	// Определяем текст и состояние кнопки
	const getButtonProps = () => {
		if (status === 'member') return { text: 'Уже в команде', disabled: true };
		if (status === 'applied') return { text: 'Откликнуто', disabled: true };
		return { text: loading ? 'Загрузка...' : 'Откликнуться', disabled: loading };
	};

	const props = getButtonProps();

	return (
		<Button 
			onClick={handleApply} 
			disabled={props.disabled} 
			className='w-full'
		>
			{props.text}
		</Button>
	);
};

export default ApplyButton;
</file>

