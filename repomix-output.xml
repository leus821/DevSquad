<file path="src/entities/user/lib/useProfile.js">
'use client';
import { supabase } from '@/shared/lib/supabase';
import { useEffect, useState } from 'react';

const useProfile = userId => {
	const [data, setData] = useState(null);
	const [loading, setLoading] = useState(true);

	useEffect(() => {
		if (!userId) return;

		const fetchFullProfile = async () => {
			try {
				setLoading(true);
				
				// 1. Получаем данные профиля
				const { data: profile } = await supabase
					.from('profiles')
					.select('*')
					.eq('id', userId)
					.single();

				if (profile) {
					// 2. Проекты, которые он СОЗДАЛ (как владелец)
					const { data: founded } = await supabase
						.from('projects')
						.select('*')
						.eq('owner_id', userId);

					// 3. Проекты, где он УЧАСТНИК (поиск в JSONB колонке members)
					const { data: joined } = await supabase
						.from('projects')
						.select('*')
						.contains('members', [{ user_id: userId }]);

					// Объединяем списки, чтобы не было дубликатов (если владелец добавил сам себя в members)
					const allActiveProjects = [...(founded || [])];
					joined?.forEach(proj => {
						if (!allActiveProjects.find(p => p.id === proj.id)) {
							allActiveProjects.push(proj);
						}
					});

					setData({ 
						...profile, 
						active_projects: allActiveProjects 
					});
				}
			} catch (e) {
				console.error("Ошибка загрузки профиля:", e);
			} finally {
				setLoading(false);
			}
		};
		fetchFullProfile();
	}, [userId]);

	return { data, loading };
};

export default useProfile;
</file>

